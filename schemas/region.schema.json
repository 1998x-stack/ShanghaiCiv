{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shanghaiciv.invalid/schemas/region.schema.json",
  "title": "ShanghaiCiv region v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name_zh",
    "kind",
    "parent_id",
    "code",
    "geometry_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name_zh": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "municipality",
        "district",
        "zone",
        "hex_cell",
        "facility"
      ]
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "geometry_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
